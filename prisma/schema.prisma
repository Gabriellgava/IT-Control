generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Usuario {
  id            String         @id @default(cuid())
  nome          String?
  email         String?        @unique
  emailVerified DateTime?      @map("email_verified")
  image         String?
  senha         String?
  perfil        String         @default("usuario")
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now()) @map("criado_em")
  accounts      Account[]
  movimentacoes Movimentacao[]
  sessions      Session[]
  termosCriados Termo[]

  @@map("usuarios")
}

model Categoria {
  id            String    @id @default(cuid())
  nome          String    @unique
  estoqueMinimo Int       @default(0) @map("estoque_minimo")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  produtos      Produto[]

  @@map("categorias")
}

model Fornecedor {
  id            String         @id @default(cuid())
  nome          String
  contato       String?
  email         String?
  telefone      String?
  site          String?
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em")
  movimentacoes Movimentacao[]
  produtos      Produto[]

  @@map("fornecedores")
}

model Setor {
  id            String         @id @default(cuid())
  nome          String         @unique
  criadoEm      DateTime       @default(now()) @map("criado_em")
  funcionarios  Funcionario[]
  movimentacoes Movimentacao[]

  @@map("setores")
}

model Funcionario {
  id       String   @id @default(cuid())
  nome     String
  setorId  String   @map("setor_id")
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")
  email    String?
  setor    Setor    @relation(fields: [setorId], references: [id])
  termos   Termo[]

  @@unique([nome, setorId])
  @@map("funcionarios")
}

model Produto {
  id            String      @id @default(cuid())
  nome          String
  codigo        String      @unique
  categoriaId   String?     @map("categoria_id")
  fornecedorId  String?     @map("fornecedor_id")
  valorUnitario Float       @default(0) @map("valor_unitario")
  linkCompra    String?     @map("link_compra")
  observacoes   String?
  criadoEm      DateTime    @default(now()) @map("criado_em")
  atualizadoEm  DateTime    @updatedAt @map("atualizado_em")
  documentos    Documento[]
  categoria     Categoria?  @relation(fields: [categoriaId], references: [id])
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  unidades      Unidade[]

  @@map("produtos")
}

model Unidade {
  id            String         @id @default(cuid())
  produtoId     String         @map("produto_id")
  etiqueta      String         @unique
  dataCompra    DateTime?      @map("data_compra")
  status        String         @default("ATIVA")
  criadoEm      DateTime       @default(now()) @map("criado_em")
  movimentacoes Movimentacao[]
  produto       Produto        @relation(fields: [produtoId], references: [id])

  @@map("unidades")
}

model Movimentacao {
  id            String      @id @default(cuid())
  tipo          String
  subtipo       String?
  unidadeId     String      @map("unidade_id")
  valorUnitario Float       @default(0) @map("valor_unitario")
  data          DateTime    @default(now())
  fornecedorId  String?     @map("fornecedor_id")
  setorId       String?     @map("setor_id")
  usuarioId     String?     @map("usuario_id")
  responsavel   String?
  observacoes   String?
  cancelado     Boolean     @default(false)
  canceladoEm   DateTime?   @map("cancelado_em")
  canceladoPor  String?     @map("cancelado_por")
  criadoEm      DateTime    @default(now()) @map("criado_em")
  documentos    Documento[]
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  setor         Setor?      @relation(fields: [setorId], references: [id])
  unidade       Unidade     @relation(fields: [unidadeId], references: [id])
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])

  @@map("movimentacoes")
}

model Inventario {
  id           String   @id @default(cuid())
  setor        String
  responsavel  String
  tipo         String
  marca        String
  modelo       String
  etiqueta     String   @unique
  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  numero       String?  @map("numero")

  @@map("inventario")
}

model Empresa {
  id                       String   @id @default(cuid())
  razaoSocial              String   @map("razao_social")
  nomeFantasia             String?  @map("nome_fantasia")
  cnpj                     String   @unique
  endereco                 String?
  telefone                 String?
  logoUrl                  String?  @map("logo_url")
  criadoEm                 DateTime @default(now()) @map("criado_em")
  atualizadoEm             DateTime @updatedAt @map("atualizado_em")
  assinaturaAutomatica     Boolean  @default(false) @map("assinatura_automatica")
  assinaturaUrl            String?  @map("assinatura_url")
  bairro                   String?
  cep                      String?
  cidade                   String?
  complemento              String?
  emailCorporativo         String?  @map("email_corporativo")
  estado                   String?
  exibirCargoRepresentante Boolean  @default(true) @map("exibir_cargo_representante")
  inscricaoEstadual        String?  @map("inscricao_estadual")
  mostrarEnderecoNoTermo   Boolean  @default(true) @map("mostrar_endereco_no_termo")
  numero                   String?
  representanteCargo       String?  @map("representante_cargo")
  representanteEmail       String?  @map("representante_email")
  representanteNome        String?  @map("representante_nome")
  representanteTelefone    String?  @map("representante_telefone")
  rua                      String?
  usarLogoNoPdf            Boolean  @default(true) @map("usar_logo_no_pdf")
  website                  String?

  @@map("empresas")
}

model Termo {
  id                    String           @id @default(cuid())
  titulo                String
  conteudoHtml          String           @map("conteudo_html")
  status                TermoStatus      @default(PENDENTE)
  funcionarioId         String           @map("funcionario_id")
  criadoPorId           String?          @map("criado_por_id")
  driveFolderId         String?          @map("drive_folder_id")
  criadoEm              DateTime         @default(now()) @map("criado_em")
  atualizadoEm          DateTime         @updatedAt @map("atualizado_em")
  acceptedTerms         Boolean          @default(false) @map("accepted_terms")
  driveFileId           String?          @map("drive_file_id")
  driveFileLink         String?          @map("drive_file_link")
  signatureImageDataUrl String?          @map("signature_image_data_url")
  signedAt              DateTime?        @map("signed_at")
  signerIp              String?          @map("signer_ip")
  signerName            String?          @map("signer_name")
  signerUserAgent       String?          @map("signer_user_agent")
  token                 String           @unique
  criadoPor             Usuario?         @relation(fields: [criadoPorId], references: [id])
  funcionario           Funcionario      @relation(fields: [funcionarioId], references: [id])
  auditorias            TermoAuditoria[]

  @@index([funcionarioId])
  @@index([status])
  @@map("termos")
}

model TermoAuditoria {
  id        String   @id @default(cuid())
  termoId   String   @map("termo_id")
  evento    String
  detalhes  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  atorId    String?  @map("ator_id")
  criadoEm  DateTime @default(now()) @map("criado_em")
  termo     Termo    @relation(fields: [termoId], references: [id], onDelete: Cascade)

  @@index([termoId, criadoEm])
  @@map("termos_auditoria")
}

model Documento {
  id             String        @id @default(cuid())
  nomeArquivo    String        @map("nome_arquivo")
  tipoArquivo    String?       @map("tipo_arquivo")
  tamanho        Int?          @map("tamanho")
  driveFileId    String?       @map("drive_file_id")
  driveLink      String?       @map("drive_link")
  driveFolderId  String?       @map("drive_folder_id")
  criadoEm       DateTime      @default(now()) @map("criado_em")
  produtoId      String?       @map("produto_id")
  licencaId      String?       @map("licenca_id")
  assinaturaId   String?       @map("assinatura_id")
  movimentacaoId String?       @map("movimentacao_id")
  tipoDocumento  TipoDocumento
  assinatura     Assinatura?   @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  licenca        Licenca?      @relation(fields: [licencaId], references: [id], onDelete: Cascade)
  movimentacao   Movimentacao? @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)
  produto        Produto?      @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@index([movimentacaoId])
  @@index([licencaId])
  @@index([assinaturaId])
  @@map("documentos")
}

model Licenca {
  id              String      @id @default(cuid())
  solicitadoPor   String?     @map("solicitado_por")
  maquinaEtiqueta String?     @map("maquina_etiqueta")
  produtoLicenca  String      @map("produto_licenca")
  codigoLicenca   String?     @map("codigo_licenca")
  criadoEm        DateTime    @default(now()) @map("criado_em")
  atualizadoEm    DateTime    @updatedAt @map("atualizado_em")
  documentos      Documento[]

  @@map("licencas")
}

model Assinatura {
  id           String      @id @default(cuid())
  plataforma   String
  setor        String
  periodo      String
  email        String
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")
  documentos   Documento[]

  @@map("assinaturas")
}

enum TermoStatus {
  PENDENTE
  VISUALIZADO
  ASSINADO
  CANCELADO
}

enum TipoDocumento {
  NOTA_FISCAL
  CONTRATO
  LICENCA
  COMPROVANTE
  OUTRO
}
