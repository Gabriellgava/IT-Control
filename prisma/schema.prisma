generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Usuario {
  id            String         @id @default(cuid())
  nome          String?
  email         String?        @unique
  emailVerified DateTime?      @map("email_verified")
  image         String?
  senha         String?
  perfil        String         @default("usuario")
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now()) @map("criado_em")
  accounts      Account[]
  sessions      Session[]
  movimentacoes Movimentacao[]
  termosCriados Termo[]

  @@map("usuarios")
}

model Categoria {
  id            String    @id @default(cuid())
  nome          String    @unique
  estoqueMinimo Int       @default(0) @map("estoque_minimo")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  produtos      Produto[]

  @@map("categorias")
}

model Fornecedor {
  id            String         @id @default(cuid())
  nome          String
  contato       String?
  email         String?
  telefone      String?
  site          String?
  criadoEm      DateTime       @default(now()) @map("criado_em")
  atualizadoEm  DateTime       @updatedAt @map("atualizado_em")
  produtos      Produto[]
  movimentacoes Movimentacao[]

  @@map("fornecedores")
}

model Setor {
  id            String         @id @default(cuid())
  nome          String         @unique
  criadoEm      DateTime       @default(now()) @map("criado_em")
  movimentacoes Movimentacao[]
  funcionarios  Funcionario[]

  @@map("setores")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  setorId   String   @map("setor_id")
  setor     Setor    @relation(fields: [setorId], references: [id])
  ativo     Boolean  @default(true)
  email     String?
  criadoEm  DateTime @default(now()) @map("criado_em")
  termos     Termo[]

  @@unique([nome, setorId])
  @@map("funcionarios")
}

model Produto {
  id            String     @id @default(cuid())
  nome          String
  codigo        String     @unique
  categoriaId   String?    @map("categoria_id")
  categoria     Categoria? @relation(fields: [categoriaId], references: [id])
  fornecedorId  String?    @map("fornecedor_id")
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  valorUnitario Float      @default(0) @map("valor_unitario")
  linkCompra    String?    @map("link_compra")
  observacoes   String?
  criadoEm      DateTime   @default(now()) @map("criado_em")
  atualizadoEm  DateTime   @updatedAt @map("atualizado_em")
  unidades      Unidade[]

  @@map("produtos")
}

model Unidade {
  id            String         @id @default(cuid())
  produtoId     String         @map("produto_id")
  produto       Produto        @relation(fields: [produtoId], references: [id])
  etiqueta      String         @unique
  dataCompra    DateTime?      @map("data_compra")
  status        String         @default("ATIVA")
  criadoEm      DateTime       @default(now()) @map("criado_em")
  movimentacoes Movimentacao[]

  @@map("unidades")
}

model Movimentacao {
  id            String      @id @default(cuid())
  tipo          String
  subtipo       String?
  unidadeId     String      @map("unidade_id")
  unidade       Unidade     @relation(fields: [unidadeId], references: [id])
  valorUnitario Float       @default(0) @map("valor_unitario")
  data          DateTime    @default(now())
  fornecedorId  String?     @map("fornecedor_id")
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  setorId       String?     @map("setor_id")
  setor         Setor?      @relation(fields: [setorId], references: [id])
  usuarioId     String?     @map("usuario_id")
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  responsavel   String?
  observacoes   String?
  cancelado     Boolean     @default(false)
  canceladoEm   DateTime?   @map("cancelado_em")
  canceladoPor  String?     @map("cancelado_por")
  criadoEm      DateTime    @default(now()) @map("criado_em")

  @@map("movimentacoes")
}

model Inventario {
  id           String   @id @default(cuid())
  setor        String
  responsavel  String
  tipo         String
  marca        String
  modelo       String
  etiqueta     String   @unique
  numero       String?  @map("numero")
  observacoes  String?
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("inventario")
}

model Empresa {
  id                      String   @id @default(cuid())
  razaoSocial             String   @map("razao_social")
  nomeFantasia            String?  @map("nome_fantasia")
  cnpj                    String   @unique
  inscricaoEstadual       String?  @map("inscricao_estadual")
  emailCorporativo        String?  @map("email_corporativo")
  telefone                String?
  website                 String?
  endereco                String?
  cep                     String?
  rua                     String?
  numero                  String?
  complemento             String?
  bairro                  String?
  cidade                  String?
  estado                  String?
  representanteNome       String?  @map("representante_nome")
  representanteCargo      String?  @map("representante_cargo")
  representanteEmail      String?  @map("representante_email")
  representanteTelefone   String?  @map("representante_telefone")
  logoUrl                 String?  @map("logo_url")
  assinaturaUrl           String?  @map("assinatura_url")
  usarLogoNoPdf           Boolean  @default(true) @map("usar_logo_no_pdf")
  exibirCargoRepresentante Boolean @default(true) @map("exibir_cargo_representante")
  assinaturaAutomatica    Boolean  @default(false) @map("assinatura_automatica")
  mostrarEnderecoNoTermo  Boolean  @default(true) @map("mostrar_endereco_no_termo")

  criadoEm                DateTime @default(now()) @map("criado_em")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  @@map("empresas")
}

enum TermoStatus {
  PENDENTE
  VISUALIZADO
  ASSINADO
  CANCELADO
}

model Termo {
  id                 String             @id @default(cuid())
  titulo             String
  conteudoHtml       String             @map("conteudo_html")
  status             TermoStatus        @default(PENDENTE)
  funcionarioId      String             @map("funcionario_id")
  funcionario        Funcionario        @relation(fields: [funcionarioId], references: [id])
  criadoPorId        String?            @map("criado_por_id")
  criadoPor          Usuario?           @relation(fields: [criadoPorId], references: [id])
  token              String             @unique
  signedAt            DateTime?          @map("signed_at")
  signerIp            String?            @map("signer_ip")
  signerUserAgent     String?            @map("signer_user_agent")
  signerName          String?            @map("signer_name")
  signatureImageDataUrl String?          @map("signature_image_data_url")
  acceptedTerms       Boolean            @default(false) @map("accepted_terms")
  driveFolderId       String?            @map("drive_folder_id")
  driveFileId         String?            @map("drive_file_id")
  driveFileLink       String?            @map("drive_file_link")
  criadoEm           DateTime           @default(now()) @map("criado_em")
  atualizadoEm       DateTime           @updatedAt @map("atualizado_em")
  auditorias         TermoAuditoria[]

  @@index([funcionarioId])
  @@index([status])
  @@map("termos")
}

model TermoAuditoria {
  id          String   @id @default(cuid())
  termoId     String   @map("termo_id")
  termo       Termo    @relation(fields: [termoId], references: [id], onDelete: Cascade)
  evento      String
  detalhes    Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  atorId      String?  @map("ator_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([termoId, criadoEm])
  @@map("termos_auditoria")
}
